BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
MAX_STILL_BYTES=52428800
MAX_MOTION_BYTES=262144000
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# FFPROBE_PATH=/absolute/path/to/ffprobe
DEEPSEEK_API_KEY=<your-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
MODEL_GATEWAY_TIMEOUT_MS=60000
MODEL_GATEWAY_MAX_RETRIES=1
DEEPSEEK_IMAGE_DETAIL=low
# 是否允许前端卡片重试；false 时隐藏重试按钮与「重试中/需更新」筛选
RETRY_ENABLED=true
# Python 分析链路（默认使用仓库内 resources/deepseek/crawl/workflow-analyze.py）
# 依赖与模型默认取自仓库内 models/，可用下列变量覆盖
# WORKFLOW_PYTHON=/usr/bin/python3
# WORKFLOW_MODELS_DIR=/absolute/path/to/models
# WORKFLOW_PYTHONPATH=/absolute/path/to/models/pylibs39
# SAM_CHECKPOINT=/absolute/path/to/models/sam_vit_b.pth
# EASYOCR_MODEL_DIR=/absolute/path/to/models/easyocr-model
# WORKFLOW_ANALYZE_SCRIPT=/absolute/path/to/resources/deepseek/crawl/workflow-analyze.py
